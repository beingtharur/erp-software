# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="file:./prisma/dev.db"

# Required — the app throws at boot without this. Used to sign session JWTs
# (src/lib/session.ts). Generate a long random value, e.g. `openssl rand -base64 32`.
SESSION_SECRET=""

# Optional. Set this in production on a host with a persistent disk (e.g.
# Render, Railway, a VPS) to point the SQLite file and uploaded documents at
# the mounted volume instead of the app's local checkout. Leave unset locally
# — the app then uses prisma/dev.db and public/uploads exactly as before.
# DATA_DIR="/data"

# Manual UPI/bank payment collection details, shown on the subscription payment
# page. src/lib/billing/payment-config.ts falls back to placeholder demo
# values if these are unset, but production must set real values here.
PAYMENT_UPI_ID="eostechno@upi"
PAYMENT_ACCOUNT_NAME="EOS Techno Private Limited"
PAYMENT_BANK_NAME="HDFC Bank"
PAYMENT_ACCOUNT_NUMBER="50100123456789"
PAYMENT_IFSC="HDFC0000123"

# Optional. Sends real "forgot password" emails via Gmail's free SMTP relay
# (src/lib/email.ts). Without these set, the reset link is logged to the
# server console instead of emailed — fine for local dev, not for production.
# SMTP_USER is the sending Gmail address; SMTP_APP_PASSWORD is a Google
# Account "App Password" (Account > Security > 2-Step Verification > App
# passwords) — never the account's real login password.
# SMTP_USER="you@gmail.com"
# SMTP_APP_PASSWORD=""

# Optional. Overrides the base URL used to build password-reset links (e.g.
# once you have a real domain). Without it, the URL is derived from the
# incoming request's Host header, which already works correctly today.
# APP_BASE_URL="https://yourdomain.com"
