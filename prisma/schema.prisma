// EOS Techno Ops Platform — demo schema
// Covers CRM, HRMS, Vendor Management, and GPS & Field Tracking

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------- Organizations / Multi-tenancy ----------
// Every tenant (customer company) is one Organization row. Root models that have
// no parent to scope through (User, Employee, Client, Vendor, GeofenceZone) carry
// organizationId directly; everything else is scoped transitively via those FKs
// in queries (e.g. LeaveRequest via employee.organizationId) rather than
// duplicating the column onto all ~27 models.

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  users         User[]
  employees     Employee[]
  clients       Client[]
  vendors       Vendor[]
  geofenceZones GeofenceZone[]
  subscription  Subscription?
  payments      Payment[]
}

// ---------- Auth ----------

enum AccessRole {
  ADMIN
  SALES
  FIELD
  HR
  PROCUREMENT
  FINANCE
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  passwordSalt        String
  accessRole          AccessRole
  employeeId          String?              @unique
  employee            Employee?            @relation(fields: [employeeId], references: [id])
  // Nullable by design, not just migration leftover: the platform super-admin
  // (isSuperAdmin=true) reviews payments across every organization and therefore
  // belongs to none. Every regular org user has this set at creation time.
  organizationId      String?
  organization        Organization?        @relation(fields: [organizationId], references: [id])
  isSuperAdmin        Boolean              @default(false)
  notifications       Notification[]
  moduleAccess        UserModuleAccess[]
  paymentsSubmitted   Payment[]            @relation("PaymentSubmittedBy")
  paymentsReviewed    Payment[]            @relation("PaymentReviewedBy")
  passwordResetTokens PasswordResetToken[]
  createdAt           DateTime             @default(now())

  @@index([organizationId])
}

// Only the token's hash is ever stored — the raw token exists only in the
// emailed link and is never persisted, so a DB leak alone can't be used to
// reset anyone's password. usedAt makes every token single-use.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

// ---------- Shared / HRMS ----------

enum EmployeeRole {
  INSTALLATION_CREW
  TECHNICIAN
  SALES_REP
  ENGINEER
  PROJECT_MANAGER
  ADMIN
  HR
  FINANCE
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

model Employee {
  id             String         @id @default(cuid())
  employeeCode   String         @unique
  name           String
  role           EmployeeRole
  department     String
  email          String         @unique
  phone          String
  dateOfJoining  DateTime
  status         EmployeeStatus @default(ACTIVE)
  baseLocation   String
  avatarSeed     String
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  reportingToId  String?
  reportingTo    Employee?      @relation("ReportsTo", fields: [reportingToId], references: [id])
  directReports  Employee[]     @relation("ReportsTo")

  user User?

  attendances    Attendance[]
  leaveRequests  LeaveRequest[]
  payrollRecords PayrollRecord[]
  timesheets     Timesheet[]
  ownedLeads     Lead[]          @relation("LeadOwner")
  siteVisits     SiteVisit[]
  locationPings  LocationPing[]
  visitLogs      VisitLog[]

  approvalRequestsMade         ApprovalRequest[]     @relation("ApprovalRequestedBy")
  approvalRequestsDecided      ApprovalRequest[]     @relation("ApprovalDecidedBy")
  personalTasks                PersonalTask[]
  tasksAssignedByMe            PersonalTask[]        @relation("TaskAssignedBy")
  taskComments                 TaskComment[]
  dailySummaries               DailySummary[]
  assignedProjectTasks         ProjectTask[]
  assignedTickets              SupportTicket[]
  expenseClaims                ExpenseClaim[]
  budgetsRequested             Budget[]
  documents                    EmployeeDocument[]    @relation("EmployeeDocuments")
  documentsUploaded            EmployeeDocument[]    @relation("DocumentUploadedBy")
  siteVisitAttachmentsUploaded SiteVisitAttachment[]
  salaryStructures             SalaryStructure[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
  HOLIDAY
}

model Attendance {
  id          String           @id @default(cuid())
  employeeId  String
  employee    Employee         @relation(fields: [employeeId], references: [id])
  date        DateTime
  checkIn     DateTime?
  checkOut    DateTime?
  status      AttendanceStatus
  hoursWorked Float            @default(0)

  createdAt DateTime @default(now())

  @@unique([employeeId, date])
}

enum LeaveType {
  SICK
  CASUAL
  EARNED
  UNPAID
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model LeaveRequest {
  id         String      @id @default(cuid())
  employeeId String
  employee   Employee    @relation(fields: [employeeId], references: [id])
  type       LeaveType
  startDate  DateTime
  endDate    DateTime
  days       Float
  status     LeaveStatus @default(PENDING)
  reason     String
  appliedOn  DateTime    @default(now())
  decidedOn  DateTime?
  decidedBy  String?
}

enum PayrollStatus {
  PROCESSED
  PENDING
}

model PayrollRecord {
  id                String           @id @default(cuid())
  employeeId        String
  employee          Employee         @relation(fields: [employeeId], references: [id])
  month             Int
  year              Int
  basicSalary       Float
  allowances        Float
  bonus             Float            @default(0)
  overtimePay       Float            @default(0)
  deductions        Float
  netPay            Float
  status            PayrollStatus    @default(PENDING)
  paidOn            DateTime?
  salaryStructureId String?
  salaryStructure   SalaryStructure? @relation(fields: [salaryStructureId], references: [id])

  @@unique([employeeId, month, year])
}

// One active structure per employee, enforced in application code (createSalaryStructure
// deactivates the prior active row inside a transaction before creating the new one) —
// SQLite/Prisma has no portable partial-unique-index for "unique where isActive=true".
// Historical rows are never deleted or overwritten, so past PayrollRecords keep pointing
// at (and were generated from) the structure that was actually active at the time.
model SalaryStructure {
  id               String   @id @default(cuid())
  employeeId       String
  employee         Employee @relation(fields: [employeeId], references: [id])
  basicSalary      Float
  hra              Float    @default(0)
  da               Float    @default(0)
  travelAllowance  Float    @default(0)
  medicalAllowance Float    @default(0)
  specialAllowance Float    @default(0)
  bonus            Float    @default(0)
  pf               Float    @default(0)
  esi              Float    @default(0)
  professionalTax  Float    @default(0)
  incomeTax        Float    @default(0)
  overtimeRate     Float    @default(0)
  effectiveFrom    DateTime
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  payrollRecords PayrollRecord[]

  @@index([employeeId, isActive])
}

model Timesheet {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id])
  projectId       String?
  project         Project? @relation(fields: [projectId], references: [id])
  date            DateTime
  hoursLogged     Float
  taskDescription String
  billable        Boolean  @default(true)

  createdAt DateTime @default(now())
}

// ---------- CRM ----------

enum Industry {
  PHARMACEUTICALS
  CHEMICALS
  COSMETICS
  BIOTECH
  FOOD_AND_BEVERAGE
}

model Client {
  id             String       @id @default(cuid())
  name           String
  industry       Industry
  tier           String
  city           String
  state          String
  contactName    String
  contactTitle   String
  contactEmail   String
  contactPhone   String
  logoSeed       String
  status         String       @default("Active")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  leads          Lead[]
  quotations     Quotation[]
  siteVisits     SiteVisit[]
  amcContracts   AmcContract[]
  projects       Project[]
  geofenceZones  GeofenceZone[]
  supportTickets SupportTicket[]

  createdAt DateTime @default(now())

  @@index([organizationId])
}

enum LeadSource {
  RFQ
  TENDER
  REFERRAL
  WEBSITE
  EXHIBITION
}

enum LeadStage {
  NEW
  QUALIFIED
  QUOTATION_SENT
  NEGOTIATION
  WON
  LOST
}

enum ProductLine {
  PROCESS_EQUIPMENT
  CONTAINMENT_SYSTEMS
  PIPING_DISTRIBUTION
  TURNKEY_PROJECTS
}

model Lead {
  id                String      @id @default(cuid())
  title             String
  clientId          String
  client            Client      @relation(fields: [clientId], references: [id])
  source            LeadSource
  productLine       ProductLine
  stage             LeadStage   @default(NEW)
  value             Float
  probability       Int
  expectedCloseDate DateTime
  ownerId           String
  owner             Employee    @relation("LeadOwner", fields: [ownerId], references: [id])
  notes             String?

  quotations Quotation[]
  siteVisits SiteVisit[]
  projects   Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum QuotationStatus {
  DRAFT
  SENT
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model Quotation {
  id          String          @id @default(cuid())
  quoteNumber String          @unique
  leadId      String?
  lead        Lead?           @relation(fields: [leadId], references: [id])
  clientId    String
  client      Client          @relation(fields: [clientId], references: [id])
  amount      Float
  status      QuotationStatus @default(DRAFT)
  revision    Int             @default(1)
  validUntil  DateTime
  issuedOn    DateTime        @default(now())

  lineItems QuotationLineItem[]
  project   Project?
}

model QuotationLineItem {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  description String
  quantity    Float
  unitPrice   Float
  amount      Float
  sortOrder   Int       @default(0)
}

enum SiteVisitStatus {
  SCHEDULED
  IN_PROGRESS
  RESCHEDULED
  COMPLETED
  CANCELLED
}

enum VisitPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum VisitType {
  INSTALLATION
  INSPECTION
  SALES
  MAINTENANCE
  SUPPORT
  FOLLOW_UP
}

enum VisitOutcome {
  INTERESTED
  NOT_INTERESTED
  NEEDS_QUOTATION
  FOLLOW_UP_REQUIRED
  NO_DECISION
  OTHER
}

enum RecommendedAction {
  CREATE_QUOTATION
  SCHEDULE_FOLLOW_UP
  TECHNICAL_REVIEW
  AWAIT_CUSTOMER
  CLOSE_LEAD
  OTHER
}

model SiteVisit {
  id            String          @id @default(cuid())
  clientId      String
  client        Client          @relation(fields: [clientId], references: [id])
  projectId     String?
  project       Project?        @relation(fields: [projectId], references: [id])
  leadId        String?
  lead          Lead?           @relation(fields: [leadId], references: [id])
  purpose       String
  visitType     VisitType       @default(SALES)
  priority      VisitPriority   @default(MEDIUM)
  scheduledDate DateTime
  assignedToId  String
  assignedTo    Employee        @relation(fields: [assignedToId], references: [id])
  status        SiteVisitStatus @default(SCHEDULED)
  notes         String?
  followUpDate  DateTime?

  // On-site contact for this specific visit — a client can have several contacts,
  // the main Client record only stores one.
  contactName  String?
  contactPhone String?
  contactEmail String?

  // Structured address, kept fully in the schema for future flexibility. The v1 UI
  // only exposes addressLine/landmark/mapsLink — city/state/pincode stay null and
  // every read view falls back to the client's city/state, so they're safe to add
  // to the form later without another migration.
  addressLine String?
  city        String?
  state       String?
  pincode     String?
  landmark    String?
  mapsLink    String?

  // Real elapsed time, distinct from the planned scheduledDate.
  actualStartTime DateTime?
  actualEndTime   DateTime?
  durationMinutes Int?

  rescheduleReason String? // latest reason only — no history log

  // Completion report — populated only when completeSiteVisit runs.
  outcome                VisitOutcome?
  outcomeNotes           String?
  customerFeedback       String?
  recommendedAction      RecommendedAction?
  recommendedActionNotes String?

  attachments SiteVisitAttachment[]
}

model SiteVisitAttachment {
  id           String    @id @default(cuid())
  siteVisitId  String
  siteVisit    SiteVisit @relation(fields: [siteVisitId], references: [id], onDelete: Cascade)
  fileUrl      String
  storageKey   String
  fileName     String
  fileSize     Int
  uploadedById String
  uploadedBy   Employee  @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime  @default(now())

  @@index([siteVisitId])
}

enum AmcStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
}

enum BillingFrequency {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  ANNUALLY
}

model AmcContract {
  id               String    @id @default(cuid())
  contractNumber   String    @unique
  clientId         String
  client           Client    @relation(fields: [clientId], references: [id])
  projectId        String?
  project          Project?  @relation(fields: [projectId], references: [id])
  contractName     String?
  equipmentCovered String
  startDate        DateTime
  endDate          DateTime
  value            Float
  status           AmcStatus @default(ACTIVE)
  lastServiceDate  DateTime?
  nextServiceDate  DateTime?

  // Added for the "Project Completed -> Create AMC" workflow — all optional since
  // existing seeded contracts predate them.
  coverage            String?
  visitsIncluded      Int?
  responseTime        String?
  billingFrequency    BillingFrequency?
  renewalReminderDays Int?
  notes               String?

  supportTickets SupportTicket[]
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  COMMISSIONING
  COMPLETED
}

model Project {
  id              String        @id @default(cuid())
  name            String
  description     String?
  clientId        String
  client          Client        @relation(fields: [clientId], references: [id])
  leadId          String?
  lead            Lead?         @relation(fields: [leadId], references: [id])
  quotationId     String?       @unique
  quotation       Quotation?    @relation(fields: [quotationId], references: [id])
  productLine     ProductLine
  industry        Industry
  value           Float
  startDate       DateTime
  targetEndDate   DateTime
  status          ProjectStatus @default(PLANNING)
  progressPercent Int           @default(0)

  timesheets    Timesheet[]
  siteVisits    SiteVisit[]
  geofenceZones GeofenceZone[]
  milestones    Milestone[]
  tasks         ProjectTask[]
  amcContracts  AmcContract[]
}

enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  DELAYED
}

model Milestone {
  id        String          @id @default(cuid())
  projectId String
  project   Project         @relation(fields: [projectId], references: [id])
  title     String
  dueDate   DateTime
  status    MilestoneStatus @default(PLANNED)
  sortOrder Int             @default(0)

  tasks ProjectTask[]
}

enum ProjectTaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model ProjectTask {
  id          String            @id @default(cuid())
  projectId   String
  project     Project           @relation(fields: [projectId], references: [id])
  milestoneId String?
  milestone   Milestone?        @relation(fields: [milestoneId], references: [id])
  title       String
  assigneeId  String?
  assignee    Employee?         @relation(fields: [assigneeId], references: [id])
  status      ProjectTaskStatus @default(TODO)
  dueDate     DateTime?
  createdAt   DateTime          @default(now())

  @@index([projectId, status])
}

// ---------- Helpdesk / Ticketing ----------

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model SupportTicket {
  id              String         @id @default(cuid())
  ticketNumber    String         @unique
  clientId        String
  client          Client         @relation(fields: [clientId], references: [id])
  amcContractId   String?
  amcContract     AmcContract?   @relation(fields: [amcContractId], references: [id])
  subject         String
  description     String
  priority        TicketPriority @default(MEDIUM)
  status          TicketStatus   @default(OPEN)
  assigneeId      String?
  assignee        Employee?      @relation(fields: [assigneeId], references: [id])
  resolutionNotes String?
  createdAt       DateTime       @default(now())
  resolvedAt      DateTime?

  @@index([status])
  @@index([clientId])
}

// ---------- Vendor Management ----------

model Vendor {
  id             String       @id @default(cuid())
  name           String
  category       String
  contactName    String
  contactEmail   String
  contactPhone   String
  city           String
  rating         Float
  status         String       @default("Active")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  purchaseOrders PurchaseOrder[]
  payments       VendorPayment[]

  createdAt DateTime @default(now())

  @@index([organizationId])
}

enum PoStatus {
  DRAFT
  SENT
  CONFIRMED
  DELIVERED
  CANCELLED
}

model PurchaseOrder {
  id               String   @id @default(cuid())
  poNumber         String   @unique
  vendorId         String
  vendor           Vendor   @relation(fields: [vendorId], references: [id])
  itemsDescription String
  amount           Float
  orderDate        DateTime
  expectedDelivery DateTime
  status           PoStatus @default(DRAFT)

  payments VendorPayment[]
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
}

model VendorPayment {
  id              String         @id @default(cuid())
  vendorId        String
  vendor          Vendor         @relation(fields: [vendorId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  amount          Float
  dueDate         DateTime
  paidDate        DateTime?
  status          PaymentStatus  @default(PENDING)
  method          String?
}

// ---------- GPS & Field Tracking ----------

model GeofenceZone {
  id             String       @id @default(cuid())
  name           String
  clientId       String?
  client         Client?      @relation(fields: [clientId], references: [id])
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id])
  latitude       Float
  longitude      Float
  radiusMeters   Int          @default(300)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  locationPings LocationPing[]
  visitLogs     VisitLog[]

  @@index([organizationId])
}

model LocationPing {
  id          String        @id @default(cuid())
  employeeId  String
  employee    Employee      @relation(fields: [employeeId], references: [id])
  latitude    Float
  longitude   Float
  timestamp   DateTime      @default(now())
  geofenceId  String?
  geofence    GeofenceZone? @relation(fields: [geofenceId], references: [id])
  isDeviceGps Boolean       @default(false)
}

enum VisitLogStatus {
  CHECKED_IN
  CHECKED_OUT
}

model VisitLog {
  id              String         @id @default(cuid())
  employeeId      String
  employee        Employee       @relation(fields: [employeeId], references: [id])
  geofenceId      String
  geofence        GeofenceZone   @relation(fields: [geofenceId], references: [id])
  purpose         String
  checkInTime     DateTime
  checkOutTime    DateTime?
  durationMinutes Int?
  status          VisitLogStatus @default(CHECKED_IN)
  notes           String?
}

// ---------- Approval Engine ----------
// Generic approval routing, reusable across entity types. Purchase Orders are the
// first consumer; Finance expense/budget approvals are expected to plug in the same
// way in a later phase (see ApprovalEntityType).

enum ApprovalEntityType {
  PURCHASE_ORDER
  EXPENSE_CLAIM
  BUDGET
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model ApprovalRequest {
  id            String             @id @default(cuid())
  entityType    ApprovalEntityType
  entityId      String
  requestedById String
  requestedBy   Employee           @relation("ApprovalRequestedBy", fields: [requestedById], references: [id])
  approverRole  AccessRole
  status        ApprovalStatus     @default(PENDING)
  decidedById   String?
  decidedBy     Employee?          @relation("ApprovalDecidedBy", fields: [decidedById], references: [id])
  decidedOn     DateTime?
  note          String?
  createdAt     DateTime           @default(now())

  @@index([entityType, entityId])
  @@index([status, approverRole])
}

// ---------- Personal Productivity ----------

enum PersonalTaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum PersonalTaskPriority {
  LOW
  MEDIUM
  HIGH
}

// employeeId is always the assignee. assignedById is null for a self-created
// task and set to the manager's employeeId for a manager-assigned one — the
// same board serves both without a parallel task system.
model PersonalTask {
  id           String               @id @default(cuid())
  employeeId   String
  employee     Employee             @relation(fields: [employeeId], references: [id])
  assignedById String?
  assignedBy   Employee?            @relation("TaskAssignedBy", fields: [assignedById], references: [id])
  title        String
  description  String?
  priority     PersonalTaskPriority @default(MEDIUM)
  status       PersonalTaskStatus   @default(TODO)
  isBlocked    Boolean              @default(false)
  blockerNote  String?
  dueDate      DateTime?
  comments     TaskComment[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([employeeId, status])
  @@index([assignedById])
}

model TaskComment {
  id        String       @id @default(cuid())
  taskId    String
  task      PersonalTask @relation(fields: [taskId], references: [id])
  authorId  String
  author    Employee     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime     @default(now())

  @@index([taskId])
}

// One evening/day-end submission per employee per day — a manager-readable
// rollup distinct from the tasks themselves (a task's status is live/ongoing;
// a summary is a point-in-time report the employee chooses to write).
model DailySummary {
  id             String   @id @default(cuid())
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id])
  date           DateTime
  completedNote  String?
  inProgressNote String?
  pendingNote    String?
  blockersNote   String?
  updatesNote    String?
  nextDayPlan    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([employeeId, date])
}

// ---------- Finance ----------
// Expense claims and budget proposals both route through the generalized approval
// engine (see ApprovalEntityType) — expense claims to FINANCE, budgets to ADMIN.

enum ExpenseCategory {
  TRAVEL
  MEALS
  SUPPLIES
  EQUIPMENT
  SOFTWARE
  OTHER
}

enum ExpenseClaimStatus {
  PENDING
  APPROVED
  REJECTED
  REIMBURSED
}

model ExpenseClaim {
  id           String             @id @default(cuid())
  claimNumber  String             @unique
  employeeId   String
  employee     Employee           @relation(fields: [employeeId], references: [id])
  category     ExpenseCategory
  amount       Float
  expenseDate  DateTime
  description  String
  status       ExpenseClaimStatus @default(PENDING)
  createdAt    DateTime           @default(now())
  reimbursedOn DateTime?

  @@index([employeeId, status])
}

enum BudgetStatus {
  PENDING
  APPROVED
  REJECTED
}

model Budget {
  id             String          @id @default(cuid())
  department     String
  category       ExpenseCategory
  startDate      DateTime
  endDate        DateTime
  proposedAmount Float
  requestedById  String
  requestedBy    Employee        @relation(fields: [requestedById], references: [id])
  status         BudgetStatus    @default(PENDING)
  createdAt      DateTime        @default(now())

  @@index([department, category])
}

// ---------- Document Management ----------
// Local filesystem storage for dev/demo (see src/lib/storage.ts) — swappable to
// Vercel Blob/S3 in production without changing this model or its callers.

enum DocumentType {
  ID_PROOF
  OFFER_LETTER
  CONTRACT
  CERTIFICATE
  OTHER
}

model EmployeeDocument {
  id           String       @id @default(cuid())
  employeeId   String
  employee     Employee     @relation("EmployeeDocuments", fields: [employeeId], references: [id])
  type         DocumentType
  fileName     String
  fileUrl      String
  storageKey   String
  fileSize     Int
  uploadedById String
  uploadedBy   Employee     @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  createdAt    DateTime     @default(now())

  @@index([employeeId])
}

// ---------- Subscription / Billing ----------
// One Subscription row per Organization is the whole trial+billing state machine —
// TRIAL is a status on this row, not a separate model. Module keys are the same
// strings as NavSection["key"] in src/lib/nav.ts ("crm" | "hrms" | "vendors" |
// "field" | "finance"), kept as plain strings here rather than a Prisma enum so
// new modules never require a migration.

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
  PAYMENT_PENDING
  PAYMENT_FAILED
}

model Subscription {
  id                 String             @id @default(cuid())
  organizationId     String             @unique
  organization       Organization       @relation(fields: [organizationId], references: [id])
  status             SubscriptionStatus @default(TRIAL)
  trialStartedAt     DateTime           @default(now())
  trialEndsAt        DateTime
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  licencedUsers      Int                @default(5)
  cancelledAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  modules  SubscriptionModule[]
  payments Payment[]
}

model SubscriptionModule {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  module         String

  @@unique([subscriptionId, module])
}

// Per-user module grants. Auto-seeded at user-creation time to match the modules
// their AccessRole already unlocks (roleSectionAccess in nav.ts), so this table is
// purely additive on top of the existing role system — nothing changes for anyone
// until an admin deliberately grants a user an extra module.
model UserModuleAccess {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  module    String
  grantedAt DateTime @default(now())

  @@unique([userId, module])
}

enum PaymentMethod {
  UPI
  BANK_TRANSFER
}

// Distinct from the existing vendor-side PaymentStatus (PENDING/PAID/OVERDUE) —
// this tracks manual UPI/bank subscription payments awaiting admin verification.
enum ManualPaymentStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
}

model Payment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  submittedById  String
  submittedBy    User         @relation("PaymentSubmittedBy", fields: [submittedById], references: [id])

  numUsers      Int
  modules       String // JSON-encoded array of module keys, e.g. '["crm","hrms"]'
  amount        Float // computed server-side from pricing-config.ts, never trusted from the client
  method        PaymentMethod
  utr           String        @unique // the duplicate-payment guard (Phase 14)
  payerUpiId    String?
  screenshotUrl String?
  notes         String?
  paymentDate   DateTime

  status          ManualPaymentStatus @default(PENDING)
  rejectionReason String?
  reviewedById    String?
  reviewedBy      User?               @relation("PaymentReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?

  createdAt DateTime @default(now())

  @@index([organizationId, status])
}
